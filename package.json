{
  "name": "trumen-productions-site",
  "version": "1.0.0",
  "private": true,
  "description": "TRU★MEN Productions — the company website. Static, zero-dependency, built with Node.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve --watch",
    "serve": "node build.mjs --serve",
    "test": "node build.mjs --quiet && node --test 'test/**/*.test.mjs'",
    "check": "npm run build && npm test",
    "images": "node tools/make-images.mjs"
  }
}
