# The build output. Regenerate with `npm run build`.
dist/

# There are no dependencies, but tooling still creates these.
node_modules/
package-lock.json

# Editors and platforms
.DS_Store
.vscode/
.idea/
*.swp

# Generated on demand by `npm run pitch`.
clearly-established-pitch.html
trumen-site-preview.html

# Reel renders — regenerate with `cd four-rules-reels && make all`.
four-rules-reels/out/*.mp4
four-rules-reels/out/*.wav
four-rules-reels/audio/vo/_scenes/
__pycache__/
*.pyc
.pytest_cache/
four-rules-reels/out/QC_REPORT.md
four-rules-reels/out/*.srt
four-rules-reels/out/thumbnails/

# The shorts engine has real dependencies; its lockfile is committed on purpose.
!clearly-established-shorts/package-lock.json

# Shorts engine: synced from assets/ by the prepare step; renders and caches.
clearly-established-shorts/public/
clearly-established-shorts/out/
clearly-established-shorts/.cache/
clearly-established-shorts/tools/rhubarb/
clearly-established-shorts/tools/whisper/
clearly-established-shorts/episodes/*/audio/scratch.wav
